# ─── Congressional Trading Tracker — Environment Variables ───
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to git — it contains your credentials.

# ─── Gmail Settings ───
# The email address to send reports FROM and TO (same address).
GMAIL_ADDRESS=your_email@gmail.com

# Gmail App Password (NOT your regular Gmail password).
# To generate one:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification (if not already on)
#   3. Go to https://myaccount.google.com/apppasswords
#   4. Select "Mail" and your device, then click "Generate"
#   5. Copy the 16-character password (spaces are fine) and paste it below
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ─── Congress.gov API (optional) ───
# Enables the "Legislation Timing" scoring signal, which checks whether a
# trade happened near a related committee hearing. Everything else works
# fine without this — leave it blank to skip the signal.
# Get a free key at: https://api.congress.gov/sign-up/
CONGRESS_API_KEY=
